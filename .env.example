# Application Config
PORT=3000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# Database Config (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omnichannel_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/omnichannel_db?schema=public"

# Redis Config (Cache & BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=""

# Meta Graph API (Facebook Messenger)
FACEBOOK_PAGE_ACCESS_TOKEN=your_fb_page_access_token
FACEBOOK_VERIFY_TOKEN=your_fb_webhook_verify_token
FACEBOOK_APP_SECRET=your_fb_app_secret

# PayOS Config (VietQR Automation)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# Giao Hàng Nhanh (GHN) Sandbox Config
GHN_API_TOKEN=your_ghn_api_token
GHN_SHOP_ID=your_ghn_shop_id
GHN_API_URL=https://dev-online-gateway.ghn.vn

